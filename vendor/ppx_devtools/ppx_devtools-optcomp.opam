opam-version: "2.0"
synopsis: "Lightweight ppx for conditional compilation"
description:
  "ppx_devtools-optcomp gates code at compile time with [@if] attributes, depending on the OCaml version, the operating system or the compiler flavour."
maintainer: ["Ocsigen team <dev@ocsigen.org>"]
authors: ["Ocsigen team <dev@ocsigen.org>"]
license: "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
homepage: "https://github.com/ocsigen/ppx_devtools"
bug-reports: "https://github.com/ocsigen/ppx_devtools/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "4.13"}
  "ppxlib" {>= "0.33"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ocsigen/ppx_devtools.git"
x-maintenance-intent: ["(latest)"]
