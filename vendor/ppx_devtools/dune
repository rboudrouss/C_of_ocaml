; Inline tests run natively on [@runtest], with js_of_ocaml on [@runtest-js]
; and with wasm_of_ocaml on [@runtest-wasm] (when WASM_OF_OCAML=true), so
; that neither compiler is needed to run the native tests.

(env
 (_
  (js_of_ocaml
   (flags
    (:standard -w no-missing-effects-backend))
   (link_flags
    (:standard -w no-missing-effects-backend))
   (runtest_alias runtest-js))
  (wasm_of_ocaml
   (enabled_if %{env:WASM_OF_OCAML=false})
   (runtest_alias runtest-wasm))))
