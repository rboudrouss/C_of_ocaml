# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Compiler from OCaml bytecode to C, for WebAssembly with emscripten"
description:
  "c_of_ocaml compiles OCaml bytecode executables and plugins to C, which emscripten compiles to WebAssembly and links with the OCaml runtime and the program's C stubs, as built by ocaml-emcc. It is a fork of js_of_ocaml and reuses its front-end and optimizer."
license: [
  "GPL-2.0-or-later" "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
]
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "4.14"}
  "ppxlib" {>= "0.33"}
  "ocaml-compiler-libs" {>= "v0.12.4"}
  "sedlex" {>= "3.8.1"}
  "menhir" {>= "20180523"}
  "menhirLib"
  "menhirSdk"
  "yojson" {>= "2.1"}
  "odoc" {with-doc}
]
x-maintenance-intent: ["(latest)"]
maintainer: ["rboudrouss <r.boudrouss@gmail.com>"]
authors: ["Ocsigen team <dev@ocsigen.org>" "rboudrouss <r.boudrouss@gmail.com>"]
homepage: "https://github.com/rboudrouss/C_of_ocaml"
doc: "https://github.com/rboudrouss/C_of_ocaml#readme"
bug-reports: "https://github.com/rboudrouss/C_of_ocaml/issues"
dev-repo: "git+https://github.com/rboudrouss/C_of_ocaml.git"
build: [
  ["dune" "build" "--release" "-j" jobs "c_of_ocaml.install"]
]
